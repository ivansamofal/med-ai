APP_ENV=local
LOG_LEVEL=INFO

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=medai

AWS_REGION=us-east-1
# Point at LocalStack locally; unset (comment out) to use real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_LAB_RESULT_QUEUE_NAME=lab-result-created

# Knowledge base (Phase 2)
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=medai_knowledge_base
# ATLAS_MONGO_URI=                # only needed if VECTOR_STORE_BACKEND=atlas
ATLAS_DB_NAME=medai
ATLAS_COLLECTION_NAME=knowledge_base
ATLAS_VECTOR_INDEX_NAME=vector_index

EMBEDDING_BACKEND=fastembed
FASTEMBED_MODEL_NAME=BAAI/bge-small-en-v1.5

# Recommendation chain (Phase 3)
LLM_BACKEND=fake
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=1024
